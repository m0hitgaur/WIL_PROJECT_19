# Neo4j Database Configuration (Docker instance)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Ollama Models & Endpoint
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=gemma4:26b
OLLAMA_VLM_MODEL=qwen2.5-vl:7b
OLLAMA_EMBED_MODEL=qwen3-embedding:4b

# Ingestion & Chunking
DATA_DIR=data
TABLE_IMAGE_DIR=output/table_crops
CHUNK_SIZE=800
CHUNK_OVERLAP=100
EMBEDDING_DIM=2560
